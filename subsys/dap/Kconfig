menuconfig DAP
	bool "Debug Access Port support [EXPERIMENTAL]"
	select EXPERIMENTAL
	select DP_DRIVER
	help
	  Debug Access Port support (currently CMSIS DAP only)

if DAP

config CMSIS_DAP_PACKET_COUNT
	int "Maximum packet buffers for request and response data."
	default 4
	range 1 $(UINT8_MAX)
	help
	  Maximum packet buffers for request and response data.

config CMSIS_DAP_PROBE_VENDOR
	string "Probe vendor"
	default "Zephyr"

config CMSIS_DAP_PROBE_NAME
	string "Probe name"
	default "CMSIS-DAP"

config CMSIS_DAP_BOARD_VENDOR
	string "Target board vendor"
	default ""

config CMSIS_DAP_BOARD_NAME
	string "Target board name"
	default ""

config CMSIS_DAP_DEVICE_VENDOR
	string "Target device vendor"
	default ""

config CMSIS_DAP_DEVICE_NAME
	string "Target device name"
	default ""

config DAP_BACKEND_USB
	bool "USB backend"
	depends on USB_DEVICE_STACK_NEXT
	help
	  DAP USB backend using bulk endpoints.

config DAP_BACKEND_TCP
	bool "TCP backend"
	depends on NET_SOCKETS && NET_TCP && NET_IPV4
	select NET_CONTEXT_SNDTIMEO
	help
	  DAP backend that serves one CMSIS-DAP client over TCP, using the
	  framing of the OpenOCD cmsis-dap tcp backend: an 8-byte little-endian
	  header (signature "DAP\0", 16-bit payload length, packet type and a
	  reserved byte) followed by one CMSIS-DAP request or response.

if DAP_BACKEND_TCP

config DAP_BACKEND_TCP_PORT
	int "TCP port"
	default 4441
	range 1 65535

config DAP_BACKEND_TCP_PKT_SIZE
	int "Packet size"
	default 1024
	range 64 4096
	help
	  CMSIS-DAP packet size reported to the host. Larger packets let the
	  host batch more transfers per network round trip.

config DAP_BACKEND_TCP_STACK_SIZE
	int "Thread stack size"
	default 3072

config DAP_BACKEND_TCP_THREAD_PRIORITY
	int "Thread priority"
	default 7

config DAP_BACKEND_TCP_SEND_TIMEOUT_MS
	int "Send timeout in milliseconds"
	default 5000
	help
	  The client is dropped when a response cannot be sent within this
	  time.

config DAP_BACKEND_TCP_KEEPALIVE
	bool "TCP keepalive"
	default y
	depends on NET_TCP_KEEPALIVE
	help
	  Probe idle clients so that a host which disappears without closing
	  the connection releases the debug port.

endif # DAP_BACKEND_TCP

module = DAP
module-str = dap
source "subsys/logging/Kconfig.template.log_config"

endif # DAP
